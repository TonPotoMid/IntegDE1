      "targets": [{ "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
        "rawSql": "SELECT sum(montant) AS total FROM transactions" }]
    },
    {
      "id": 3, "type": "stat", "title": "Transactions flaggées (> 5000)", "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
