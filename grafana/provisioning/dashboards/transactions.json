    {
      "id": 4, "type": "stat", "title": "Fichiers traités", "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "transactions-pg" },
      "targets": [{ "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
