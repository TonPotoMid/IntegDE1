    {
      "id": 5, "type": "barchart", "title": "Montants envoyés par banque", "gridPos": { "x": 0, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "transactions-pg" },
      "fieldConfig": { "defaults": { "unit": "currencyEUR" }, "overrides": [] },
      "targets": [{ "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
        "rawSql": "SELECT banque, total FROM sent_by_bank ORDER BY total DESC" }]
    },
    {
      "id": 6, "type": "table", "title": "Envoyé / reçu par IBAN", "gridPos": { "x": 12, "y": 4, "w": 12, "h": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "transactions-pg" },
      "targets": [{ "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
        "rawSql": "SELECT coalesce(s.iban, r.iban) AS iban, coalesce(s.total, 0) AS envoye, coalesce(r.total, 0) AS recu FROM sent_by_iban s FULL JOIN received_by_iban r ON r.iban = s.iban ORDER BY 1" }]
    },
    {
      "id": 7, "type": "table", "title": "Transactions flaggées", "gridPos": { "x": 0, "y": 13, "w": 24, "h": 8 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "transactions-pg" },
      "targets": [{ "refId": "A", "format": "table", "rawQuery": true, "editorMode": "code",
        "rawSql": "SELECT transaction_id, datetime_transaction, iban_origine, banque_source, iban_destinataire, pays_destinataire, montant FROM transactions WHERE is_flagged ORDER BY montant DESC" }]
    }
  ]
